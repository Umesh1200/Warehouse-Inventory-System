@page
@model IMS.Pages.Production.FinishedGoodsReceiptModel
@{
    ViewData["Title"] = "Finished Goods Receipt";
}

@section Styles {
    <link rel="stylesheet" href="~/css/finished-goods-receipt.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
}

<div class="receipt-container">
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <span class="material-symbols-outlined">check_circle</span> @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <span class="material-symbols-outlined">error</span> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <header class="page-header">
        <div>
            <nav class="crumbs">
                <a asp-page="/Production/Index">Manufacturing</a>
                <span>/</span>
                <a asp-page="/Production/Planning">Planning</a>
                <span>/</span>
                <span>Finished Goods Receipt</span>
            </nav>
            <h1>Finished Goods Receipt</h1>
            <p>Record produced output from production plans, move accepted goods into QC/warehouse flow, and track receipt history.</p>
            <div class="context-row">
                <span>
                    <span class="material-symbols-outlined">event_note</span>
                    @(string.IsNullOrWhiteSpace(Model.Summary.ReceiptNumber) ? "No selected receipt" : Model.Summary.ReceiptNumber)
                </span>
                <span>
                    <span class="material-symbols-outlined">precision_manufacturing</span>
                    @(string.IsNullOrWhiteSpace(Model.Summary.ProductionLine) ? "Finished goods receiving" : Model.Summary.ProductionLine)
                </span>
            </div>
        </div>
        <div class="header-actions">
            <a asp-page="/Production/MaterialIssueReturn" asp-route-PlanID="@Model.PlanID" class="btn-receipt btn-outline">
                <span class="material-symbols-outlined">output</span>
                Issue Materials
            </a>
            <button class="btn-receipt btn-primary" data-bs-toggle="modal" data-bs-target="#createReceiptModal" disabled="@(!Model.ActivePlansList.Any())">
                <span class="material-symbols-outlined">add</span>
                Record Receipt
            </button>
        </div>
    </header>

    <section class="filters-panel">
        <form method="get" class="filter-form">
            <div>
                <label for="planId">Production Plan</label>
                <select id="planId" name="PlanID" class="form-select" onchange="this.form.submit()">
                    <option value="" selected="@(Model.PlanID == null)">All active plans</option>
                    @foreach (var plan in Model.ActivePlansList)
                    {
                        <option value="@plan.ID" selected="@(Model.PlanID == plan.ID)">@plan.Number - @plan.Product</option>
                    }
                </select>
            </div>
            <div>
                <label for="searchTerm">Search</label>
                <div class="search-field">
                    <span class="material-symbols-outlined">search</span>
                    <input id="searchTerm" type="search" name="SearchTerm" value="@Model.SearchTerm" placeholder="Receipt, batch, SKU, product" />
                </div>
            </div>
            <button type="submit" class="btn-receipt btn-outline compact">
                <span class="material-symbols-outlined">filter_alt</span>
                Apply
            </button>
        </form>
    </section>

    <section class="receipt-stats-grid" aria-label="Finished goods receipt summary">
        <article class="stat-card">
            <span class="stat-label">Receipt Location</span>
            <strong><span class="material-symbols-outlined">location_on</span>@Model.Summary.Location</strong>
        </article>
        <article class="stat-card">
            <span class="stat-label">Estimated Receipt Value</span>
            <strong>@Model.Summary.TotalValue</strong>
        </article>
        <article class="stat-card">
            <span class="stat-label">Production Status</span>
            <span class="status-pill status-@Model.Summary.ProductionStatus.ToLower().Replace(" ", "-")">@Model.Summary.ProductionStatus</span>
        </article>
    </section>

    <section class="receipt-main-grid">
        <article class="panel receipt-items-panel">
            <div class="panel-header">
                <div>
                    <h2>Latest Receipt Items</h2>
                    <p>Accepted output from the latest matching receipt</p>
                </div>
                <button class="btn-receipt btn-primary compact" data-bs-toggle="modal" data-bs-target="#createReceiptModal" disabled="@(!Model.ActivePlansList.Any())">
                    <span class="material-symbols-outlined">add</span>
                    Receipt
                </button>
            </div>
            <div class="table-wrap">
                <table class="ims-table">
                    <thead>
                        <tr>
                            <th>SKU</th>
                            <th>Product</th>
                            <th class="text-right">Produced</th>
                            <th class="text-right">Accepted</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Any())
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="font-mono">@item.ItemID</td>
                                    <td><strong>@item.ProductName</strong></td>
                                    <td class="text-right font-mono">@item.TargetQty.ToString("N2")</td>
                                    <td class="text-right font-mono accepted">@item.ActualQty.ToString("N2")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4">
                                    <div class="empty-state">
                                        <span class="material-symbols-outlined">move_to_inbox</span>
                                        <strong>No receipt items found</strong>
                                        <p>Record finished goods output for an active production plan.</p>
                                        <button class="btn-receipt btn-primary" data-bs-toggle="modal" data-bs-target="#createReceiptModal" disabled="@(!Model.ActivePlansList.Any())">
                                            <span class="material-symbols-outlined">add</span>
                                            Record Receipt
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </article>

        <article class="panel history-panel">
            <div class="panel-header">
                <div>
                    <h2>Receipt History</h2>
                    <p>Recent finished goods receipts and QC/putaway status</p>
                </div>
            </div>
            <div class="table-wrap">
                <table class="ims-table">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Batch</th>
                            <th>User</th>
                            <th>Status</th>
                            <th class="text-right">Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentReceipts.Any())
                        {
                            @foreach (var history in Model.RecentReceipts)
                            {
                                <tr>
                                    <td>@history.Timestamp</td>
                                    <td class="font-mono">@history.BatchID</td>
                                    <td>@history.User</td>
                                    <td>
                                        <span class="status-pill status-@history.StatusColor">
                                            <i></i>
                                            @history.Status
                                        </span>
                                    </td>
                                    <td class="text-right font-mono">@history.Value</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5">
                                    <div class="empty-state compact-empty">
                                        <span class="material-symbols-outlined">history</span>
                                        <strong>No receipt history found</strong>
                                        <p>Try another plan or search term.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </article>
    </section>
</div>

<div class="modal fade" id="createReceiptModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Record Finished Goods Output</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Create" asp-route-PlanID="@Model.PlanID" onsubmit="return confirm('Record finished goods receipt? Accepted finished goods may still require putaway before becoming usable stock.');">
                <input type="hidden" name="PlanID" value="@Model.PlanID" />
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Receipt Number *</label>
                            <input type="text" asp-for="NewReceipt.ReceiptNumber" class="form-control" placeholder="e.g. FGR-2026-001" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Production Plan *</label>
                            <select asp-for="NewReceipt.PlanID" class="form-select" required>
                                <option value="">Select active plan</option>
                                @foreach(var p in Model.ActivePlansList) { <option value="@p.ID" selected="@(Model.PlanID == p.ID)">@p.Number - @p.Product</option> }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Produced Qty *</label>
                            <input type="number" step="0.01" min="0.01" asp-for="NewReceipt.ProducedQty" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Accepted Qty *</label>
                            <input type="number" step="0.01" min="0" asp-for="NewReceipt.AcceptedQty" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Rejected Qty *</label>
                            <input type="number" step="0.01" min="0" asp-for="NewReceipt.RejectedQty" class="form-control" value="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Batch Number</label>
                            <input type="text" asp-for="NewReceipt.BatchNumber" class="form-control" placeholder="e.g. B-2026-KTM-001" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Receiver / Staff *</label>
                            <select asp-for="NewReceipt.ReceivedBy" class="form-select" required>
                                <option value="">Select staff</option>
                                @foreach(var s in Model.StaffList) { <option value="@s.ID">@s.Name</option> }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Confirm Receipt</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/finished-goods-receipt.js" asp-append-version="true"></script>
}
