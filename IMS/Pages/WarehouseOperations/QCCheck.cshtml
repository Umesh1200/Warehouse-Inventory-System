@page
@model IMS.Pages.WarehouseOperations.QCCheckModel
@{
    ViewData["Title"] = "Quality Control Check";
}

@section Styles {
    <link rel="stylesheet" href="~/css/qc-check.css" asp-append-version="true" />
}

<div class="qc-container">
    <div class="page-header">
        <div>
            <h2 class="page-title">Quality Control Check</h2>
            <div class="page-subtitle">Inspect received goods before they are released to putaway.</div>
        </div>
        <a class="btn-ims" asp-page="/WarehouseOperations/Putaway">
            <span class="material-symbols-outlined">move_to_inbox</span>
            Putaway
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <span class="material-symbols-outlined">check_circle</span> @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <span class="material-symbols-outlined">error</span> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="qc-stats-grid">
        @foreach (var stat in Model.Stats)
        {
            <div class="stat-card">
                <div class="stat-icon @stat.ColorClass">
                    <span class="material-symbols-outlined">@stat.Icon</span>
                </div>
                <div>
                    <div class="stat-label">@stat.Title</div>
                    <div class="stat-value">@stat.Value</div>
                </div>
            </div>
        }
    </div>

    <div class="filters-panel">
        <div class="d-flex align-items-center gap-3">
            <div class="search-wrap flex-grow-1" style="max-width: 400px; position: relative;">
                <span class="material-symbols-outlined" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted);">search</span>
                <input id="qcSearch" type="text" class="filter-input w-100" style="padding-left: 40px;" placeholder="PO, supplier, SKU, batch..." />
            </div>
            <div class="dropdown" title="Filter QC Checks">
                <button class="icon-button border-0 bg-white shadow-sm d-flex align-items-center justify-content-center rounded-circle" style="width: 42px; height: 42px;" type="button" id="qcFilterDropdown" data-bs-toggle="dropdown" aria-expanded="false" data-bs-auto-close="outside">
                    <span class="material-symbols-outlined text-primary">filter_alt</span>
                </button>
                <div class="dropdown-menu dropdown-menu-end p-3 shadow-sm border-0" aria-labelledby="qcFilterDropdown" style="width: 280px; border-radius: 12px;">
                    <h6 class="dropdown-header px-0 text-dark fw-bold mb-2">Filter QC Checks</h6>
                    <div class="mb-3">
                        <label for="timeFilter" class="form-label small fw-bold text-muted mb-1">Time</label>
                        <select id="timeFilter" class="form-select form-select-sm">
                            <option value="Today" selected>Today</option>
                            <option value="All Time">All Time</option>
                        </select>
                        <div class="form-text" style="font-size: 0.75rem;">Pending tasks always show.</div>
                    </div>
                    <div class="mb-2">
                        <label for="statusFilter" class="form-label small fw-bold text-muted mb-1">Status</label>
                        <select id="statusFilter" class="form-select form-select-sm">
                            <option value="All Statuses">All Statuses</option>
                            <option value="QC Required" selected>QC Required</option>
                            <option value="Accepted">Accepted</option>
                            <option value="Rejected">Rejected</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="qc-table-panel">
        <div class="table-toolbar">
            <div>
                <div class="table-title">QC Worklist</div>
                <div class="table-meta">@Model.PendingItems.Count receipts</div>
            </div>
        </div>
        <div class="table-scroll">
            <table class="ims-table">
                <thead>
                    <tr>
                        <th>PO / Supplier</th>
                        <th>Product</th>
                        <th class="text-right">Received</th>
                        <th class="text-right">Accepted</th>
                        <th class="text-right">Damaged</th>
                        <th class="text-right">Rejected</th>
                        <th>Inspector</th>
                        <th>Status</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.PendingItems.Any())
                    {
                        <tr>
                            <td colspan="9" class="empty-cell">No QC receipts found. Receive goods first, then they will appear here.</td>
                        </tr>
                    }
                    @foreach (var item in Model.PendingItems)
                    {
                        <tr class="qc-row"
                            data-status="@item.Status"
                            data-search="@($"{item.PONumber} {item.Supplier} {item.SKU} {item.ProductName} {item.LotNumber} {item.SourceType}".ToLower())"
                            data-date="@(item.InspectionDateTime?.ToString("yyyy-MM-dd") ?? "")">
                            <td>
                                <div class="po-cell d-flex align-items-center gap-1">
                                    <span>@item.PONumber</span>
                                    @if (item.SourceType == "Production")
                                    {
                                        <span class="badge" style="background-color: #8b5cf6; color: white; font-size: 0.65rem; padding: 2px 6px; border-radius: 4px;">PROD</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary" style="font-size: 0.65rem; padding: 2px 6px; border-radius: 4px;">PO</span>
                                    }
                                </div>
                                <div class="muted-cell">@item.Supplier</div>
                            </td>
                            <td>
                                <div class="product-cell">@item.ProductName</div>
                                <div class="muted-cell">SKU: @item.SKU</div>
                                <div class="batch-pill">Batch: @item.LotNumber</div>
                            </td>
                            <td class="text-right font-mono">@item.ReceivedQty.ToString("N0")</td>
                            <td class="text-right font-mono text-success">@item.AcceptedQty.ToString("N0")</td>
                            <td class="text-right font-mono text-warning">@item.DamagedQty.ToString("N0")</td>
                            <td class="text-right font-mono text-danger">@item.RejectedQty.ToString("N0")</td>
                            <td>
                                <div>@item.InspectorName</div>
                                <div class="muted-cell">@item.InspectionDate</div>
                            </td>
                            <td>
                                <span class="status-badge status-@item.StatusColor">@item.Status</span>
                            </td>
                            <td class="text-center">
                                @if (item.CanInspect)
                                {
                                    <button type="button"
                                            class="icon-button qc-submit-btn"
                                            title="Submit QC"
                                            data-bs-toggle="modal"
                                            data-bs-target="#qcModal"
                                            data-receiptid="@item.ReceiptID"
                                            data-fgreceiptid="@item.FGReceiptID"
                                            data-source="@item.SourceType"
                                            data-po="@item.PONumber"
                                            data-supplier="@item.Supplier"
                                            data-sku="@item.SKU"
                                            data-product="@item.ProductName"
                                            data-batch="@item.LotNumber"
                                            data-received="@item.ReceivedQty">
                                        <span class="material-symbols-outlined">fact_check</span>
                                    </button>
                                }
                                else if (item.Status == "Accepted")
                                {
                                    <a class="icon-button success" asp-page="/WarehouseOperations/Putaway" title="Open Putaway">
                                        <span class="material-symbols-outlined">move_to_inbox</span>
                                    </a>
                                }
                                else
                                {
                                    <span class="muted-cell">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="qcModal" tabindex="-1" aria-labelledby="qcModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content ims-modal">
            <div class="modal-header ims-modal-header">
                <h5 class="modal-title" id="qcModalLabel">Submit QC Result</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="SubmitQC" onsubmit="return confirm('Submit QC result? Accepted quantity can move to putaway.');">
                <input type="hidden" id="qc-receiptid" asp-for="NewQCResult.ReceiptID" />
                <input type="hidden" id="qc-fgreceiptid" asp-for="NewQCResult.FGReceiptID" />
                <input type="hidden" id="qc-itemsource" asp-for="NewQCResult.ItemSource" />
                <div class="modal-body">
                    <div class="qc-context">
                        <div>
                            <span id="label-po">Reference / PO</span>
                            <strong id="disp-po"></strong>
                        </div>
                        <div>
                            <span id="label-supplier">Source</span>
                            <strong id="disp-supplier"></strong>
                        </div>
                    </div>

                    <div class="product-summary">
                        <div>
                            <div id="disp-product" class="product-title"></div>
                            <div id="disp-sku" class="muted-cell"></div>
                            <div id="disp-batch" class="batch-pill"></div>
                        </div>
                        <div class="qty-summary">
                            Received Qty <strong id="disp-received">0</strong>
                        </div>
                    </div>

                    <div class="form-grid">
                        <div>
                            <label class="form-label">Accepted Qty *</label>
                            <input type="number" step="0.01" id="input-accepted" asp-for="NewQCResult.AcceptedQty" class="form-control" min="0" required />
                        </div>
                        <div>
                            <label class="form-label">Damaged Qty *</label>
                            <input type="number" step="0.01" id="input-damaged" asp-for="NewQCResult.DamagedQty" class="form-control" min="0" required />
                        </div>
                        <div>
                            <label class="form-label">Rejected Qty *</label>
                            <input type="number" step="0.01" id="input-rejected" asp-for="NewQCResult.RejectedQty" class="form-control" min="0" required />
                        </div>
                        <div>
                            <label class="form-label">Total Check</label>
                            <input type="text" id="input-total" class="form-control" readonly />
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label">Remarks</label>
                        <textarea asp-for="NewQCResult.Remarks" class="form-control" rows="3" placeholder="Optional notes for audit trail"></textarea>
                        <div class="field-hint">Accepted + damaged + rejected must exactly equal received quantity.</div>
                    </div>
                </div>
                <div class="modal-footer ims-modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit QC</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/qc-check.js" asp-append-version="true"></script>
}
