@page
@model IMS.Pages.Purchasing.PurchaseOrderPrintModel
@{ Layout = null; var po = Model.Order; }
<!DOCTYPE html><html><head><meta charset="utf-8" /><title>@po.PONumber - Purchase Order</title><meta name="viewport" content="width=device-width" />
<style>
*{box-sizing:border-box}body{margin:0;background:#eef2f6;color:#172033;font:14px Arial,sans-serif}.toolbar{position:sticky;top:0;padding:12px;text-align:center;background:#12243a}.toolbar button{border:0;border-radius:6px;background:#fff;color:#12243a;font-weight:700;padding:10px 20px;cursor:pointer}.sheet{width:210mm;min-height:297mm;margin:20px auto;padding:18mm;background:#fff;box-shadow:0 4px 22px #0002}.top{display:flex;justify-content:space-between;border-bottom:3px solid #123f69;padding-bottom:18px}.brand h1{color:#123f69;margin:0 0 8px;font-size:25px}.title{text-align:right}.title h2{font-size:29px;color:#123f69;margin:0}.meta,.parties{display:grid;grid-template-columns:1fr 1fr;gap:30px;margin:22px 0}.meta div,.party{line-height:1.7}.label{display:inline-block;color:#657184;font-weight:700;min-width:125px}.party{border:1px solid #dce3ea;border-radius:6px;padding:14px}.party h3{margin:0 0 8px;color:#123f69;font-size:13px;text-transform:uppercase}table{width:100%;border-collapse:collapse;margin-top:18px}th{background:#123f69;color:#fff;text-align:left;padding:10px}td{padding:10px;border:1px solid #d7dee7}.num{text-align:right}.totals{margin-left:auto;width:46%;margin-top:15px}.totals td:first-child{font-weight:700}.grand td{font-size:17px;font-weight:800;background:#e8f0f8}.terms{margin-top:45px;border-top:1px solid #b9c5d3;padding-top:15px;color:#4f5c6d}.signature{display:flex;justify-content:space-between;margin-top:65px}.signature div{width:35%;border-top:1px solid #333;padding-top:8px;text-align:center}.muted{color:#687385}@@page{size:A4;margin:0}@@media print{body{background:#fff}.toolbar{display:none}.sheet{margin:0;box-shadow:none;width:auto;min-height:auto}}
</style></head><body><div class="toolbar"><button onclick="window.print()">Print / Save as PDF</button></div><main class="sheet">
<div class="top"><div class="brand"><h1>InventoryPro</h1><div>Internal Inventory Management System</div><div class="muted">Authorized purchase document</div></div><div class="title"><h2>PURCHASE ORDER</h2><strong>@po.PONumber</strong></div></div>
<div class="meta"><div><div><span class="label">PO Date</span>@po.OrderDate.ToString("dd MMMM yyyy")</div><div><span class="label">Expected Date</span>@(po.ExpectedDate?.ToString("dd MMMM yyyy") ?? "To be confirmed")</div><div><span class="label">Status</span>@po.POStatus</div></div><div><div><span class="label">Supplier response</span>@po.SupplierConfirmationStatus</div><div><span class="label">Promised date</span>@(po.PromisedDeliveryDate?.ToString("dd MMMM yyyy") ?? "Not confirmed")</div></div></div>
<div class="parties"><div class="party"><h3>Supplier</h3><strong>@po.SupplierName</strong><br/>@po.ContactPerson<br/>@po.SupplierAddress<br/>@po.SupplierEmail<br/>@po.SupplierPhone</div><div class="party"><h3>Deliver to</h3><strong>InventoryPro Receiving Department</strong><br/>Please quote PO number on all delivery and invoice documents.</div></div>
<table><thead><tr><th>#</th><th>Item</th><th>SKU</th><th class="num">Quantity</th><th class="num">Unit price</th><th class="num">Amount</th></tr></thead><tbody>@for(var i=0;i<po.Items.Count;i++){var item=po.Items[i];<tr><td>@(i+1)</td><td>@item.ProductName</td><td>@item.SKU</td><td class="num">@item.OrderedQty.ToString("N2")</td><td class="num">Rs. @item.UnitPrice.ToString("N2")</td><td class="num">Rs. @item.TotalPrice.ToString("N2")</td></tr>}</tbody></table>
<table class="totals"><tr class="grand"><td>Grand Total</td><td class="num">Rs. @po.TotalAmount.ToString("N2")</td></tr></table>
<div class="terms"><strong>Terms and instructions</strong><p>@(string.IsNullOrWhiteSpace(po.Remarks) ? "Please acknowledge this order and confirm the delivery date. Goods are subject to receiving inspection and quality control. Payment is processed against the supplier invoice after PO, receipt, and QC verification." : po.Remarks)</p></div>
<div class="signature"><div>Prepared / Approved by</div><div>Supplier acknowledgement</div></div>
</main></body></html>
