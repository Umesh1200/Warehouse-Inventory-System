@page "{id:int}"
@model IMS.Pages.Inventory.Products.EditModel
@using System.Text.Encodings.Web
@{
    ViewData["Title"] = "Edit Product Details";
}

@section Styles {
    <link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom">
                    <h5 class="mb-0 fw-bold text-primary">Edit Product Details: @Model.Product.ProductName</h5>
                    <div class="d-flex align-items-center gap-2">
                        @if (Model.CanManageAttributes)
                        {
                            <div class="dropdown d-inline-block">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle d-flex align-items-center gap-1" type="button" id="editManageDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="material-symbols-outlined" style="font-size: 16px;">tune</span>
                                    Manage Master Data
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border" aria-labelledby="editManageDropdown" style="font-size: 0.85rem;">
                                    <li>
                                        <button class="dropdown-item d-flex align-items-center gap-2 py-2" type="button" data-bs-toggle="modal" data-bs-target="#manageCategoriesModal">
                                            <span class="material-symbols-outlined text-primary" style="font-size: 16px;">category</span>
                                            <span>Manage Categories</span>
                                        </button>
                                    </li>
                                    <li>
                                        <button class="dropdown-item d-flex align-items-center gap-2 py-2" type="button" data-bs-toggle="modal" data-bs-target="#manageUnitsModal">
                                            <span class="material-symbols-outlined text-primary" style="font-size: 16px;">straighten</span>
                                            <span>Manage Units</span>
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        }
                        <a asp-page="/Inventory/Products" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
                            <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span>
                            Back to List
                        </a>
                    </div>
                </div>
                
                <form method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Product.ProductID" />
                    <div class="card-body p-4">
                        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                        {
                            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                                <span class="material-symbols-outlined" style="vertical-align: middle;">check_circle</span>
                                @Model.SuccessMessage
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger mb-4">
                                <span class="material-symbols-outlined" style="vertical-align: middle;">error</span>
                                @Model.ErrorMessage
                            </div>
                        }

                        @if (!Model.CanEdit)
                        {
                            <div class="alert alert-warning mb-4">
                                <span class="material-symbols-outlined" style="vertical-align: middle;">info</span>
                                Only Admin can edit Product Master data. You are in read-only mode.
                            </div>
                        }

                        <div class="row g-4">
                            <!-- Basic Information -->
                            <div class="col-12">
                                <h6 class="text-uppercase text-muted fw-bold" style="font-size: 11px; letter-spacing: 1px;">Basic Information</h6>
                                <hr class="mt-1 mb-3" />
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Product SKU *</label>
                                <input asp-for="Product.SKU" class="form-control" readonly="@(!Model.CanEdit)" />
                                <span asp-validation-for="Product.SKU" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Product Name *</label>
                                <input asp-for="Product.ProductName" class="form-control" readonly="@(!Model.CanEdit)" />
                                <span asp-validation-for="Product.ProductName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label fw-semibold small mb-0">Category *</label>
                                    @if (Model.CanManageAttributes)
                                    {
                                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-primary" data-bs-toggle="modal" data-bs-target="#manageCategoriesModal" style="font-size: 11px; font-weight: 700;">+ Manage</button>
                                    }
                                </div>
                                <select asp-for="Product.CategoryID" class="form-select" disabled="@(!Model.CanEdit)">
                                    <option value="">Select Category</option>
                                    @foreach (var cat in Model.CategoriesList)
                                    {
                                        <option value="@cat.ID">@cat.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="Product.CategoryID" class="text-danger small"></span>
                                @if(!Model.CanEdit) { <input type="hidden" asp-for="Product.CategoryID" /> }
                            </div>

                            <div class="col-md-4">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label fw-semibold small mb-0">Unit *</label>
                                    @if (Model.CanManageAttributes)
                                    {
                                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-primary" data-bs-toggle="modal" data-bs-target="#manageUnitsModal" style="font-size: 11px; font-weight: 700;">+ Manage</button>
                                    }
                                </div>
                                <select asp-for="Product.UnitID" class="form-select" disabled="@(!Model.CanEdit)">
                                    <option value="">Select Unit</option>
                                    @foreach (var unit in Model.UnitsList)
                                    {
                                        <option value="@unit.ID">@unit.Name (@unit.Code)</option>
                                    }
                                </select>
                                <span asp-validation-for="Product.UnitID" class="text-danger small"></span>
                                @if(!Model.CanEdit) { <input type="hidden" asp-for="Product.UnitID" /> }
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold small">Product Type *</label>
                                <select asp-for="Product.ProductType" class="form-select" disabled="@(!Model.CanEdit)">
                                    @foreach (var type in Model.ProductTypes)
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </select>
                                <span asp-validation-for="Product.ProductType" class="text-danger small"></span>
                                @if(!Model.CanEdit) { <input type="hidden" asp-for="Product.ProductType" /> }
                            </div>

                            <!-- Financial & Operational -->
                            <div class="col-12 mt-5">
                                <h6 class="text-uppercase text-muted fw-bold" style="font-size: 11px; letter-spacing: 1px;">Financial & Operational</h6>
                                <hr class="mt-1 mb-3" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-semibold small">Standard Cost (NPR)</label>
                                <input type="number" step="0.01" asp-for="Product.StandardCost" class="form-control" readonly="@(!Model.CanEdit)" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-semibold small">Selling Price (NPR)</label>
                                <input type="number" step="0.01" asp-for="Product.SellingPrice" class="form-control" readonly="@(!Model.CanEdit)" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-semibold small">Reorder Level</label>
                                <input type="number" asp-for="Product.ReorderLevel" class="form-control" readonly="@(!Model.CanEdit)" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-semibold small">Status *</label>
                                <select asp-for="Product.Status" class="form-select" disabled="@(!Model.CanEdit)">
                                    <option value="Active">Active</option>
                                    <option value="Inactive">Inactive</option>
                                </select>
                                @if(!Model.CanEdit) { <input type="hidden" asp-for="Product.Status" /> }
                            </div>

                            <!-- Physical Specs -->
                            <div class="col-12 mt-5">
                                <h6 class="text-uppercase text-muted fw-bold" style="font-size: 11px; letter-spacing: 1px;">Physical Specifications</h6>
                                <hr class="mt-1 mb-3" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold small">Weight (kg)</label>
                                <input type="number" step="0.001" asp-for="Product.WeightKg" class="form-control" readonly="@(!Model.CanEdit)" />
                            </div>

                            <div class="col-md-8">
                                <label class="form-label fw-semibold small">Dimensions / Specs</label>
                                <input type="text" asp-for="Product.Dimensions" class="form-control" readonly="@(!Model.CanEdit)" />
                            </div>

                            <div class="col-12 mt-5">
                                <h6 class="text-uppercase text-muted fw-bold" style="font-size: 11px; letter-spacing: 1px;">Product Image</h6>
                                <hr class="mt-1 mb-3" />
                            </div>
                            
                            <div class="col-12 mb-3">
                                <label class="form-label fw-semibold small">Image Preview</label>
                                <div>
                                    <img id="imagePreview" src="@(string.IsNullOrEmpty(Model.Product.ImageUrl) ? "/images/placeholder.png" : Model.Product.ImageUrl)" alt="Product Preview" style="max-height: 150px; border-radius: 8px; border: 1px solid var(--border); object-fit: contain;" onerror="this.src='/images/placeholder.png'" />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Upload Local Image</label>
                                <input type="file" id="fileUploadInput" asp-for="ImageUpload" class="form-control" accept="image/*" disabled="@(!Model.CanEdit)" />
                                <div class="form-text">Choose a local file from your computer.</div>
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">OR Web URL Link</label>
                                <input type="url" id="urlInput" asp-for="Product.ImageUrl" class="form-control" placeholder="https://..." readonly="@(!Model.CanEdit)" />
                                <div class="form-text">Paste a web link to an external image. (Overridden if local file is selected)</div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-light p-4 text-end">
                        <a asp-page="/Inventory/Products" class="btn btn-light px-4 me-2">Cancel</a>
                        @if (Model.CanEdit)
                        {
                            <button type="submit" class="btn btn-primary px-5">Save Product Info</button>
                        }
                    </div>
                </form>
            </div>

            <!-- Disclaimer -->
            <div class="mt-4 p-3 bg-white rounded shadow-sm border">
                <div class="d-flex gap-2">
                    <span class="material-symbols-outlined text-info">info</span>
                    <div>
                        <p class="mb-0 fw-bold small">Master Data vs Inventory</p>
                        <p class="mb-0 text-muted small">
                            Changing these fields will NOT affect current stock quantities. 
                            To change physical stock, use the <a asp-page="/Inventory/Adjustments" asp-route-productId="@Model.Product.ProductID">Inventory Adjustment Request</a> workflow.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Category Management Modal -->
<div class="modal fade" id="manageCategoriesModal" tabindex="-1" aria-labelledby="manageCategoriesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="manageCategoriesModalLabel">Product Categories Master</h5>
                    <p class="text-white-50 mb-0" style="font-size: 13px;">Manage item classifications, descriptions, and active status.</p>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="avl-split-container">
                    <!-- Left Panel: Add / Edit Form -->
                    <div class="avl-form-card">
                        <form method="post" id="categoryForm" asp-page-handler="SaveCategory" asp-route-id="@Model.Product.ProductID">
                            <input type="hidden" asp-for="CategoryForm.CategoryID" id="categoryFormId" value="0" />
                            <h6 id="categoryFormTitle">Add New Category</h6>
                            
                            <label>
                                <span>Category Name *</span>
                                <input type="text" asp-for="CategoryForm.CategoryName" id="categoryFormName" placeholder="e.g. Textiles, Hardware, Packaging" required />
                            </label>

                            <label>
                                <span>Description</span>
                                <input type="text" asp-for="CategoryForm.Description" id="categoryFormDesc" placeholder="Optional category details" />
                            </label>

                            <label class="check-field mt-2">
                                <input type="checkbox" asp-for="CategoryForm.IsActive" id="categoryFormActive" value="true" checked />
                                <span>Active Category</span>
                            </label>

                            <div class="form-actions mt-3">
                                <button type="submit" id="categorySubmitBtn" class="btn-ims btn-primary">Save Category</button>
                                <button type="button" id="categoryResetBtn" class="btn-ims btn-outline" style="display:none;" onclick="resetCategoryForm()">Cancel</button>
                            </div>
                        </form>
                    </div>

                    <!-- Right Panel: Category Table -->
                    <div class="avl-table-card">
                        <div class="table-wrap avl-table-wrap">
                            <table class="ims-table avl-table">
                                <thead>
                                    <tr>
                                        <th>Category Name</th>
                                        <th>Description</th>
                                        <th class="text-center">Products</th>
                                        <th>Status</th>
                                        <th class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.CategoryDetails.Any())
                                    {
                                        @foreach (var cat in Model.CategoryDetails)
                                        {
                                            <tr id="cat-row-@cat.CategoryID" class="@(!cat.IsActive ? "text-muted" : "")">
                                                <td class="fw-bold">@cat.CategoryName</td>
                                                <td>@(string.IsNullOrEmpty(cat.Description) ? "—" : cat.Description)</td>
                                                <td class="text-center">
                                                    <span class="badge bg-light text-dark font-mono">@cat.ProductCount</span>
                                                </td>
                                                <td>
                                                    <span class="badge-status @(cat.IsActive ? "status-approved" : "status-inactive")">
                                                        @(cat.IsActive ? "Active" : "Inactive")
                                                    </span>
                                                </td>
                                                <td class="text-center">
                                                    <div class="row-actions justify-content-center">
                                                        <button type="button" class="action-icon-link" title="Edit Category"
                                                                onclick="editCategory(@cat.CategoryID, '@Html.Raw(JavaScriptEncoder.Default.Encode(cat.CategoryName))', '@Html.Raw(JavaScriptEncoder.Default.Encode(cat.Description))', @(cat.IsActive ? "true" : "false"))">
                                                            <span class="material-symbols-outlined">edit</span>
                                                        </button>
                                                        <form method="post" asp-page-handler="ToggleCategoryStatus" asp-route-id="@Model.Product.ProductID" style="margin:0; display:inline;" 
                                                              onsubmit="return confirm('@(cat.IsActive ? $"Deactivate category \'{cat.CategoryName}\'?" : $"Activate category \'{cat.CategoryName}\'?")');">
                                                            <input type="hidden" name="ToggleCategoryID" value="@cat.CategoryID" />
                                                            <button type="submit" class="action-icon-link @(cat.IsActive ? "danger-action" : "success-action")" 
                                                                    title="@(cat.IsActive ? "Deactivate" : "Activate")">
                                                                <span class="material-symbols-outlined">@(cat.IsActive ? "toggle_on" : "toggle_off")</span>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center py-3 text-muted">No categories configured yet.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Unit Management Modal -->
<div class="modal fade" id="manageUnitsModal" tabindex="-1" aria-labelledby="manageUnitsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="manageUnitsModalLabel">Units of Measurement (UoM) Master</h5>
                    <p class="text-white-50 mb-0" style="font-size: 13px;">Configure unit names, abbreviations, and active status.</p>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="avl-split-container">
                    <!-- Left Panel: Add / Edit Form -->
                    <div class="avl-form-card">
                        <form method="post" id="unitForm" asp-page-handler="SaveUnit" asp-route-id="@Model.Product.ProductID">
                            <input type="hidden" asp-for="UnitForm.UnitID" id="unitFormId" value="0" />
                            <h6 id="unitFormTitle">Add New Unit</h6>
                            
                            <label>
                                <span>Unit Name *</span>
                                <input type="text" asp-for="UnitForm.UnitName" id="unitFormName" placeholder="e.g. Kilogram, Meter, Pieces" required />
                            </label>

                            <label>
                                <span>Unit Code (Abbr) *</span>
                                <input type="text" asp-for="UnitForm.UnitCode" id="unitFormCode" placeholder="e.g. KG, MTR, PCS, ROLL" maxlength="10" required />
                            </label>

                            <label class="check-field mt-2">
                                <input type="checkbox" asp-for="UnitForm.IsActive" id="unitFormActive" value="true" checked />
                                <span>Active Unit</span>
                            </label>

                            <div class="form-actions mt-3">
                                <button type="submit" id="unitSubmitBtn" class="btn-ims btn-primary">Save Unit</button>
                                <button type="button" id="unitResetBtn" class="btn-ims btn-outline" style="display:none;" onclick="resetUnitForm()">Cancel</button>
                            </div>
                        </form>
                    </div>

                    <!-- Right Panel: Units Table -->
                    <div class="avl-table-card">
                        <div class="table-wrap avl-table-wrap">
                            <table class="ims-table avl-table">
                                <thead>
                                    <tr>
                                        <th>Unit Name</th>
                                        <th>Code</th>
                                        <th class="text-center">Products</th>
                                        <th>Status</th>
                                        <th class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.UnitDetails.Any())
                                    {
                                        @foreach (var unit in Model.UnitDetails)
                                        {
                                            <tr id="unit-row-@unit.UnitID" class="@(!unit.IsActive ? "text-muted" : "")">
                                                <td class="fw-bold">@unit.UnitName</td>
                                                <td><span class="font-mono bg-light px-2 py-1 rounded">@unit.UnitCode</span></td>
                                                <td class="text-center">
                                                    <span class="badge bg-light text-dark font-mono">@unit.ProductCount</span>
                                                </td>
                                                <td>
                                                    <span class="badge-status @(unit.IsActive ? "status-approved" : "status-inactive")">
                                                        @(unit.IsActive ? "Active" : "Inactive")
                                                    </span>
                                                </td>
                                                <td class="text-center">
                                                    <div class="row-actions justify-content-center">
                                                        <button type="button" class="action-icon-link" title="Edit Unit"
                                                                onclick="editUnit(@unit.UnitID, '@Html.Raw(JavaScriptEncoder.Default.Encode(unit.UnitName))', '@Html.Raw(JavaScriptEncoder.Default.Encode(unit.UnitCode))', @(unit.IsActive ? "true" : "false"))">
                                                            <span class="material-symbols-outlined">edit</span>
                                                        </button>
                                                        <form method="post" asp-page-handler="ToggleUnitStatus" asp-route-id="@Model.Product.ProductID" style="margin:0; display:inline;" 
                                                              onsubmit="return confirm('@(unit.IsActive ? $"Deactivate unit \'{unit.UnitName}\'?" : $"Activate unit \'{unit.UnitName}\'?")');">
                                                            <input type="hidden" name="ToggleUnitID" value="@unit.UnitID" />
                                                            <button type="submit" class="action-icon-link @(unit.IsActive ? "danger-action" : "success-action")" 
                                                                    title="@(unit.IsActive ? "Deactivate" : "Activate")">
                                                                <span class="material-symbols-outlined">@(unit.IsActive ? "toggle_on" : "toggle_off")</span>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center py-3 text-muted">No units configured yet.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Category Form Management
        function editCategory(id, name, desc, isActive) {
            document.querySelectorAll('[id^="cat-row-"]').forEach(r => r.classList.remove('row-editing'));
            const row = document.getElementById('cat-row-' + id);
            if (row) row.classList.add('row-editing');

            const formId = document.getElementById('categoryFormId');
            const formName = document.getElementById('categoryFormName');
            const formDesc = document.getElementById('categoryFormDesc');
            const formActive = document.getElementById('categoryFormActive');
            const formTitle = document.getElementById('categoryFormTitle');
            const submitBtn = document.getElementById('categorySubmitBtn');
            const resetBtn = document.getElementById('categoryResetBtn');

            if (formId) formId.value = id;
            if (formName) formName.value = name;
            if (formDesc) formDesc.value = desc || '';
            if (formActive) formActive.checked = isActive;
            if (formTitle) formTitle.textContent = 'Edit Category';
            if (submitBtn) submitBtn.textContent = 'Update Category';
            if (resetBtn) resetBtn.style.display = 'inline-block';
        }

        function resetCategoryForm() {
            document.querySelectorAll('[id^="cat-row-"]').forEach(r => r.classList.remove('row-editing'));
            const formId = document.getElementById('categoryFormId');
            const formName = document.getElementById('categoryFormName');
            const formDesc = document.getElementById('categoryFormDesc');
            const formActive = document.getElementById('categoryFormActive');
            const formTitle = document.getElementById('categoryFormTitle');
            const submitBtn = document.getElementById('categorySubmitBtn');
            const resetBtn = document.getElementById('categoryResetBtn');

            if (formId) formId.value = '0';
            if (formName) formName.value = '';
            if (formDesc) formDesc.value = '';
            if (formActive) formActive.checked = true;
            if (formTitle) formTitle.textContent = 'Add New Category';
            if (submitBtn) submitBtn.textContent = 'Save Category';
            if (resetBtn) resetBtn.style.display = 'none';
        }

        // Unit Form Management
        function editUnit(id, name, code, isActive) {
            document.querySelectorAll('[id^="unit-row-"]').forEach(r => r.classList.remove('row-editing'));
            const row = document.getElementById('unit-row-' + id);
            if (row) row.classList.add('row-editing');

            const formId = document.getElementById('unitFormId');
            const formName = document.getElementById('unitFormName');
            const formCode = document.getElementById('unitFormCode');
            const formActive = document.getElementById('unitFormActive');
            const formTitle = document.getElementById('unitFormTitle');
            const submitBtn = document.getElementById('unitSubmitBtn');
            const resetBtn = document.getElementById('unitResetBtn');

            if (formId) formId.value = id;
            if (formName) formName.value = name;
            if (formCode) formCode.value = code;
            if (formActive) formActive.checked = isActive;
            if (formTitle) formTitle.textContent = 'Edit Unit';
            if (submitBtn) submitBtn.textContent = 'Update Unit';
            if (resetBtn) resetBtn.style.display = 'inline-block';
        }

        function resetUnitForm() {
            document.querySelectorAll('[id^="unit-row-"]').forEach(r => r.classList.remove('row-editing'));
            const formId = document.getElementById('unitFormId');
            const formName = document.getElementById('unitFormName');
            const formCode = document.getElementById('unitFormCode');
            const formActive = document.getElementById('unitFormActive');
            const formTitle = document.getElementById('unitFormTitle');
            const submitBtn = document.getElementById('unitSubmitBtn');
            const resetBtn = document.getElementById('unitResetBtn');

            if (formId) formId.value = '0';
            if (formName) formName.value = '';
            if (formCode) formCode.value = '';
            if (formActive) formActive.checked = true;
            if (formTitle) formTitle.textContent = 'Add New Unit';
            if (submitBtn) submitBtn.textContent = 'Save Unit';
            if (resetBtn) resetBtn.style.display = 'none';
        }

        document.addEventListener('DOMContentLoaded', function() {
            const fileInput = document.getElementById('fileUploadInput');
            const urlInput = document.getElementById('urlInput');
            const preview = document.getElementById('imagePreview');

            if(fileInput && preview) {
                fileInput.addEventListener('change', function() {
                    const file = this.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            preview.src = e.target.result;
                        }
                        reader.readAsDataURL(file);
                        
                        // Disable and clear URL input to avoid confusion
                        if (urlInput) {
                            urlInput.value = '';
                            urlInput.disabled = true;
                        }
                    } else {
                        // Re-enable URL input if file is deselected
                        if (urlInput) {
                            urlInput.disabled = false;
                        }
                        
                        if (urlInput && urlInput.value) {
                            preview.src = urlInput.value;
                        } else {
                            preview.src = '/images/placeholder.png';
                        }
                    }
                });
            }

            if(urlInput && preview) {
                urlInput.addEventListener('input', function() {
                    // Only update preview from URL if no file is selected
                    if (!fileInput || fileInput.files.length === 0) {
                        const val = this.value.trim();
                        if(val) {
                            preview.src = val;
                        } else {
                            preview.src = '/images/placeholder.png';
                        }
                    }
                });
            }
        });
    </script>
}
