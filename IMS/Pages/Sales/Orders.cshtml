@page
@model IMS.Pages.Sales.OrdersModel
@{
    ViewData["Title"] = "Sales Orders";
    var hasSelection = Model.SelectedOrder.SOID > 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/sales-orders.css" asp-append-version="true" />
}

<div class="sales-page">
    <header class="page-header">
        <div>
            <div class="eyebrow">
                <span class="material-symbols-outlined">receipt_long</span>
                Sales
            </div>
            <h1>Sales Orders</h1>
            <p>Manage customer demand from draft order through picking, dispatch, and fulfillment.</p>
        </div>
        <div class="header-actions">
            <a class="btn btn-light" asp-page="/WarehouseOperations/PickingPacking">
                <span class="material-symbols-outlined">inventory_2</span>
                Picking
            </a>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createSoModal">
                <span class="material-symbols-outlined">add</span>
                Create Order
            </button>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show operation-alert" role="alert">
            <span class="material-symbols-outlined">check_circle</span>
            <span>@Model.SuccessMessage</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show operation-alert" role="alert">
            <span class="material-symbols-outlined">error</span>
            <span>@Model.ErrorMessage</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <section class="summary-grid" aria-label="Sales order summary">
        @foreach (var card in Model.SummaryCards)
        {
            <article class="summary-card">
                <div class="summary-top">
                    <span class="summary-icon summary-@card.ColorClass material-symbols-outlined">@card.Icon</span>
                    <div>
                        <p>@card.Title</p>
                        <strong>@card.Value</strong>
                    </div>
                </div>
                <div class="sparkline-wrap">
                    <svg class="sparkline" viewBox="0 0 96 42" preserveAspectRatio="none" aria-hidden="true">
                        <polyline points="@card.TrendPoints"></polyline>
                    </svg>
                    <span>@card.TrendLabel</span>
                </div>
            </article>
        }
    </section>

    <section class="sales-grid">
        <aside class="orders-panel">
            <div class="panel-header">
                <div>
                    <h2>Active Sales Orders</h2>
                    <p>@Model.SalesOrders.Count order(s) in the current list</p>
                </div>
            </div>

            <div class="table-tools">
                <label class="search-wrap" for="salesOrderSearch">
                    <span class="material-symbols-outlined">search</span>
                    <input id="salesOrderSearch" type="search" placeholder="Search SO or customer" autocomplete="off" />
                </label>
                <select id="salesStatusFilter" class="form-select" aria-label="Filter sales order status">
                    <option value="">All statuses</option>
                    <option value="Draft">Draft</option>
                    <option value="Confirmed">Confirmed</option>
                    <option value="Allocated">Allocated</option>
                    <option value="Picking">Picking</option>
                    <option value="Picked">Picked</option>
                    <option value="Packed">Packed</option>
                    <option value="Dispatched">Dispatched</option>
                    <option value="Fulfilled">Fulfilled</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
            </div>

            <div class="table-wrap">
                <table class="ims-table">
                    <thead>
                        <tr>
                            <th>SO Number</th>
                            <th>Customer</th>
                            <th>Order Date</th>
                            <th class="text-end">Total</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.SalesOrders.Any())
                        {
                            @foreach (var order in Model.SalesOrders)
                            {
                                <tr class="order-row @(order.IsSelected ? "selected" : "")"
                                    data-status="@order.OrderStatus"
                                    data-search="@($"{order.SONumber} {order.Customer}")">
                                    <td>
                                        <a asp-page="./Orders" asp-route-soid="@order.SOID" class="order-link">@order.SONumber</a>
                                    </td>
                                    <td>@order.Customer</td>
                                    <td>@order.OrderDate</td>
                                    <td class="text-end mono">@order.TotalAmount</td>
                                    <td><span class="status-badge status-@order.OrderStatus.ToLower().Replace(" ", "")">@order.OrderStatus</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5">
                                    <div class="empty-state table-empty">
                                        <span class="material-symbols-outlined">receipt_long</span>
                                        <strong>No sales orders</strong>
                                        <p>Create a draft order to start the sales workflow.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </aside>

        <main class="details-panel">
            @if (hasSelection)
            {
                <div class="detail-header">
                    <div>
                        <div class="order-title-row">
                            <h2>@Model.SelectedOrder.SONumber</h2>
                            <span class="status-badge status-@Model.SelectedOrder.OrderStatus.ToLower().Replace(" ", "")">@Model.SelectedOrder.OrderStatus</span>
                        </div>
                        <p>@Model.SelectedOrder.Customer</p>
                    </div>
                    <div class="detail-actions">
                        @if (Model.SelectedOrder.OrderStatus == "Draft")
                        {
                            <button type="button"
                                    class="icon-btn edit-btn"
                                    title="Edit order"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editSoModal"
                                    data-id="@Model.SelectedOrder.SOID"
                                    data-so="@Model.SelectedOrder.SONumber"
                                    data-customer="@Model.SelectedOrder.CustomerID"
                                    data-orderdate="@Model.SelectedOrder.RawOrderDate"
                                    data-requireddate="@Model.SelectedOrder.RawRequiredDate"
                                    data-remarks="@Model.SelectedOrder.Remarks"
                                    data-items="@System.Text.Json.JsonSerializer.Serialize(Model.SelectedOrderItems.Select(i => new { i.ProductID, i.QtyOrdered, i.UnitPrice }))">
                                <span class="material-symbols-outlined">edit</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="detail-info-grid">
                    <div>
                        <span>Order Date</span>
                        <strong>@Model.SelectedOrder.OrderDate</strong>
                    </div>
                    <div>
                        <span>Required Date</span>
                        <strong>@Model.SelectedOrder.RequiredDate</strong>
                    </div>
                    <div>
                        <span>Items</span>
                        <strong>@Model.SelectedOrder.ItemCount</strong>
                    </div>
                    <div>
                        <span>Units</span>
                        <strong>@Model.SelectedOrder.TotalUnits.ToString("0.##")</strong>
                    </div>
                </div>

                <div class="subheader">
                    <h3>Line Items & Availability</h3>
                    <span>@Model.SelectedOrderItems.Count item(s)</span>
                </div>

                <div class="allocation-list">
                    @if (Model.SelectedOrderItems.Any())
                    {
                        @foreach (var item in Model.SelectedOrderItems)
                        {
                            <article class="allocation-item @item.Severity">
                                <div class="allocation-header">
                                    <div>
                                        <span class="allocation-sku">@item.SKU</span>
                                        <strong>@item.ProductName</strong>
                                    </div>
                                    <span class="mono">@item.Price</span>
                                </div>
                                <div class="allocation-stats">
                                    <div>
                                        <span>Ordered</span>
                                        <strong>@item.QtyOrdered</strong>
                                    </div>
                                    <div>
                                        <span>Available</span>
                                        <strong>@item.QtyAvailable</strong>
                                    </div>
                                    <span class="allocation-badge @item.Severity">@item.Status</span>
                                </div>
                                @if (item.Locations.Any())
                                {
                                    <div class="allocation-locations mt-2">
                                        <button class="btn btn-sm btn-link p-0 text-decoration-none d-flex align-items-center gap-1 toggle-locations-btn" type="button" style="font-size: 0.78rem; font-weight: 600; color: var(--secondary);">
                                            <span class="material-symbols-outlined" style="font-size: 1.1rem; vertical-align: middle;">location_on</span>
                                            View Locations (@item.Locations.Count)
                                        </button>
                                        <div class="locations-details mt-2 p-2 rounded d-none" style="background: var(--surface-soft); border: 1px solid var(--border-color);">
                                            <table class="table table-sm table-borderless mb-0" style="font-size: 0.75rem;">
                                                <thead>
                                                    <tr class="text-muted" style="border-bottom: 1px solid var(--border-color);">
                                                        <th>Location</th>
                                                        <th class="text-end">Current</th>
                                                        <th class="text-end">Available</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var loc in item.Locations)
                                                    {
                                                        <tr>
                                                            <td>@loc.WarehouseName / @loc.ShelfCode</td>
                                                            <td class="text-end font-monospace">@loc.CurrentQty.ToString("0.##")</td>
                                                            <td class="text-end font-monospace @(loc.AvailableQty > 0 ? "text-success" : "text-danger")">@loc.AvailableQty.ToString("0.##")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(item.Note))
                                {
                                    <p class="allocation-note">@item.Note</p>
                                }
                            </article>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <span class="material-symbols-outlined">inventory</span>
                            <strong>No line items</strong>
                            <p>This order does not currently have item rows to display.</p>
                        </div>
                    }
                </div>

                <div class="panel-footer">
                    <div class="total-row">
                        <span>Order Total</span>
                        <strong>@Model.SelectedOrder.TotalAmount</strong>
                    </div>
                    <div class="footer-actions">
                        @if (Model.SelectedOrder.OrderStatus == "Draft")
                        {
                            <form method="post" asp-page-handler="Confirm" data-confirm-message="Confirm this sales order? Stock will not be reduced until dispatch.">
                                <input type="hidden" name="ConfirmSOID" value="@Model.SelectedOrder.SOID" />
                                <button type="submit" class="btn btn-primary">
                                    <span class="material-symbols-outlined">check_circle</span>
                                    Confirm
                                </button>
                            </form>
                        }
                        @if (Model.SelectedOrder.OrderStatus == "Draft" || Model.SelectedOrder.OrderStatus == "Confirmed")
                        {
                            <form method="post" asp-page-handler="Cancel" data-confirm-message="Cancel this sales order? Historical data will be preserved.">
                                <input type="hidden" name="CancelSOID" value="@Model.SelectedOrder.SOID" />
                                <button type="submit" class="btn btn-outline-danger">
                                    <span class="material-symbols-outlined">cancel</span>
                                    Cancel
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="empty-state detail-empty">
                    <span class="material-symbols-outlined">receipt_long</span>
                    <strong>No order selected</strong>
                    <p>Select a sales order to inspect its items and availability.</p>
                </div>
            }
        </main>
    </section>
</div>

<div class="modal fade" id="createSoModal" tabindex="-1" aria-labelledby="createSoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content ims-modal">
            <div class="modal-header ims-modal-header">
                <h5 class="modal-title" id="createSoModalLabel">Create Sales Order</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="Create">
                <div class="modal-body">
                    <div class="row g-3">
                        <!-- SONumber is auto-generated -->
                        <div class="col-md-8">
                            <label class="form-label">Customer</label>
                            <select asp-for="NewSalesOrder.CustomerID" class="form-select" required>
                                <option value="">Select customer</option>
                                @foreach (var customer in Model.ActiveCustomersList)
                                {
                                    <option value="@customer.ID">[@customer.Code] @customer.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Order Date</label>
                            <input type="date" asp-for="NewSalesOrder.OrderDate" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Required Date</label>
                            <input type="date" asp-for="NewSalesOrder.RequiredDate" class="form-control" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Remarks</label>
                            <input type="text" asp-for="NewSalesOrder.Remarks" class="form-control" />
                        </div>
                        <div class="col-12"><hr /></div>
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="mb-0">Order Line Items</h6>
                                <button type="button" class="btn btn-sm btn-outline-primary" id="btnAddCreateRow">
                                    <span class="material-symbols-outlined">add</span> Add Item
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle" id="createItemsTable">
                                    <thead>
                                        <tr>
                                            <th style="width: 50%;">Product</th>
                                            <th style="width: 20%;">Qty</th>
                                            <th style="width: 20%;">Unit Price</th>
                                            <th style="width: 10%;" class="text-center">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="createItemsTbody">
                                        @if (Model.NewSalesOrder.Items != null && Model.NewSalesOrder.Items.Count > 0)
                                        {
                                            @for (int i = 0; i < Model.NewSalesOrder.Items.Count; i++)
                                            {
                                                <tr class="item-row">
                                                    <td>
                                                        <select name="NewSalesOrder.Items[@i].ProductID" class="form-select select-product" required>
                                                            <option value="">Select product</option>
                                                            @foreach (var product in Model.ActiveProductsList)
                                                            {
                                                                <option value="@product.ID" selected="@(product.ID == Model.NewSalesOrder.Items[i].ProductID ? "selected" : null)">[@product.SKU] @product.Name</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <input type="number" step="0.01" name="NewSalesOrder.Items[@i].OrderedQty" value="@Model.NewSalesOrder.Items[i].OrderedQty" class="form-control input-qty" required />
                                                    </td>
                                                    <td>
                                                        <input type="number" step="0.01" name="NewSalesOrder.Items[@i].UnitPrice" value="@Model.NewSalesOrder.Items[i].UnitPrice" class="form-control input-price" required />
                                                    </td>
                                                    <td class="text-center">
                                                        <button type="button" class="btn btn-sm btn-link text-danger btn-delete-row" @(Model.NewSalesOrder.Items.Count == 1 ? "disabled" : "")>
                                                            <span class="material-symbols-outlined">delete</span>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr class="item-row">
                                                <td>
                                                    <select name="NewSalesOrder.Items[0].ProductID" class="form-select select-product" required>
                                                        <option value="">Select product</option>
                                                        @foreach (var product in Model.ActiveProductsList)
                                                        {
                                                            <option value="@product.ID">[@product.SKU] @product.Name</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td>
                                                    <input type="number" step="0.01" name="NewSalesOrder.Items[0].OrderedQty" class="form-control input-qty" required />
                                                </td>
                                                <td>
                                                    <input type="number" step="0.01" name="NewSalesOrder.Items[0].UnitPrice" class="form-control input-price" required />
                                                </td>
                                                <td class="text-center">
                                                    <button type="button" class="btn btn-sm btn-link text-danger btn-delete-row" disabled>
                                                        <span class="material-symbols-outlined">delete</span>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer ims-modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Draft</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editSoModal" tabindex="-1" aria-labelledby="editSoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content ims-modal">
            <div class="modal-header ims-modal-header">
                <h5 class="modal-title" id="editSoModalLabel">Edit Sales Order</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="Update">
                <input type="hidden" id="edit-id" asp-for="EditSalesOrder.SOID" />
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">SO Number</label>
                            <input type="text" id="edit-so" asp-for="EditSalesOrder.SONumber" class="form-control bg-light" readonly required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Customer</label>
                            <select id="edit-customer" asp-for="EditSalesOrder.CustomerID" class="form-select" required>
                                <option value="">Select customer</option>
                                @foreach (var customer in Model.ActiveCustomersList)
                                {
                                    <option value="@customer.ID">[@customer.Code] @customer.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Order Date</label>
                            <input type="date" id="edit-orderdate" asp-for="EditSalesOrder.OrderDate" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Required Date</label>
                            <input type="date" id="edit-requireddate" asp-for="EditSalesOrder.RequiredDate" class="form-control" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Remarks</label>
                            <input type="text" id="edit-remarks" asp-for="EditSalesOrder.Remarks" class="form-control" />
                        </div>
                        <div class="col-12"><hr /></div>
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="mb-0">Order Line Items</h6>
                                <button type="button" class="btn btn-sm btn-outline-primary" id="btnAddEditRow">
                                    <span class="material-symbols-outlined">add</span> Add Item
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle" id="editItemsTable">
                                    <thead>
                                        <tr>
                                            <th style="width: 50%;">Product</th>
                                            <th style="width: 20%;">Qty</th>
                                            <th style="width: 20%;">Unit Price</th>
                                            <th style="width: 10%;" class="text-center">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="editItemsTbody">
                                        <!-- Populated dynamically by JS -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer ims-modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.activeProducts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActiveProductsList));
    </script>
    <script src="~/js/sales-orders.js" asp-append-version="true"></script>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                @if (Model.EditSalesOrder.SOID > 0)
                {
                    var editItemsJson = System.Text.Json.JsonSerializer.Serialize(Model.EditSalesOrder.Items.Select(i => new { i.ProductID, QtyOrdered = i.OrderedQty, i.UnitPrice }));
                    <text>
                    // Populate edit modal fields with submitted values to preserve them on error
                    document.getElementById('edit-id').value = "@Model.EditSalesOrder.SOID";
                    document.getElementById('edit-so').value = "@Html.Raw(Model.EditSalesOrder.SONumber)";
                    document.getElementById('edit-customer').value = "@Model.EditSalesOrder.CustomerID";
                    document.getElementById('edit-orderdate').value = "@Model.EditSalesOrder.OrderDate.ToString("yyyy-MM-dd")";
                    document.getElementById('edit-requireddate').value = "@(Model.EditSalesOrder.RequiredDate?.ToString("yyyy-MM-dd") ?? "")";
                    document.getElementById('edit-remarks').value = "@Html.Raw(Model.EditSalesOrder.Remarks)";

                    const editTbody = document.getElementById('editItemsTbody');
                    if (editTbody) {
                        editTbody.innerHTML = '';
                    }

                    const failedItems = @Html.Raw(editItemsJson);
                    if (failedItems && failedItems.length > 0) {
                        failedItems.forEach(item => {
                            if (typeof window.addEditRow === 'function') {
                                window.addEditRow(item.ProductID, item.QtyOrdered, item.UnitPrice);
                            }
                        });
                    }

                    const editModal = new bootstrap.Modal(document.getElementById('editSoModal'));
                    editModal.show();
                    </text>
                }
                else if (Model.NewSalesOrder.CustomerID > 0)
                {
                    <text>
                    const createModal = new bootstrap.Modal(document.getElementById('createSoModal'));
                    createModal.show();
                    </text>
                }
            });
        </script>
    }
}
