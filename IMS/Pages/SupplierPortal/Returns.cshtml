@page
@model IMS.Pages.SupplierPortal.ReturnsModel
@{
    ViewData["Title"] = "Returns / RTV";
}

@section Styles {
    <link rel="stylesheet" href="~/css/supplierportal/returns.css" asp-append-version="true" />
}

<div class="returns-page">
    <header class="page-header">
        <div>
            <div class="eyebrow">
                <span class="material-symbols-outlined">keyboard_return</span>
                Supplier Portal
            </div>
            <h1>Supplier Returns (RTV)</h1>
            <p>Track goods returned by the factory, authorize returns, and provide RMA (Return Merchandise Authorization) details.</p>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show operation-alert" role="alert">
            <span class="material-symbols-outlined">check_circle</span>
            <span>@Model.SuccessMessage</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show operation-alert" role="alert">
            <span class="material-symbols-outlined">error</span>
            <span>@Model.ErrorMessage</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Summary Grid -->
    <section class="summary-grid mb-4" aria-label="Return metrics">
        @foreach (var card in Model.SummaryCards)
        {
            <article class="summary-card">
                <div class="summary-top">
                    <span class="summary-icon summary-@card.ColorClass material-symbols-outlined">@card.Icon</span>
                    <div>
                        <p>@card.Title</p>
                        <strong>@card.Value</strong>
                    </div>
                </div>
            </article>
        }
    </section>

    <!-- Content Split Layout -->
    <div class="split-layout">
        <!-- Left Panel: Returns List -->
        <section class="list-panel">
            <div class="panel-header">
                <h2>Return Logs</h2>
                <span class="count-badge">@Model.ReturnsList.Count Return(s)</span>
            </div>

            <div class="list-container custom-scrollbar">
                @if (Model.ReturnsList.Any())
                {
                    @foreach (var r in Model.ReturnsList)
                    {
                        <a asp-page="/SupplierPortal/Returns" asp-route-returnId="@r.ReturnID" 
                           class="list-item @(r.IsSelected ? "active" : "")">
                            <div class="item-header">
                                <strong>@r.ReturnNo</strong>
                                <span class="badge badge-@r.Status.ToLower()">@r.Status</span>
                            </div>
                            <div class="item-meta">
                                <span>Date: @r.ReturnDate</span>
                                <span class="badge badge-credit-@r.CreditStatus.ToLower()">Credit: @r.CreditStatus</span>
                            </div>
                            <div class="item-footer">
                                <span>RMA: @(string.IsNullOrEmpty(r.RMANumber) ? "Pending" : r.RMANumber)</span>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <span class="material-symbols-outlined">assignment_return</span>
                        <p>No returns logged.</p>
                    </div>
                }
            </div>
        </section>

        <!-- Right Panel: Return Details -->
        <section class="details-panel">
            @if (Model.SelectedReturn != null)
            {
                <div class="panel-header-details">
                    <div>
                        <div class="return-title">
                            <h2>@Model.SelectedReturn.ReturnNo</h2>
                            <span class="badge badge-@Model.SelectedReturn.Status.ToLower()">@Model.SelectedReturn.Status</span>
                        </div>
                        <p class="meta">Created on @Model.SelectedReturn.CreatedAt | Inspector: @Model.SelectedReturn.CreatorName</p>
                    </div>
                    <div class="actions">
                        @if (Model.SelectedReturn.Status == "Draft")
                        {
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#supplierAuthorizeModal" 
                                    data-id="@Model.SelectedReturn.ReturnID" data-no="@Model.SelectedReturn.ReturnNo">
                                <span class="material-symbols-outlined">gavel</span>
                                Authorize & Provide RMA
                            </button>
                            <button type="button" class="btn btn-danger ms-2" data-bs-toggle="modal" data-bs-target="#supplierRejectModal"
                                    data-id="@Model.SelectedReturn.ReturnID" data-no="@Model.SelectedReturn.ReturnNo">
                                <span class="material-symbols-outlined">gavel</span>
                                Reject / Dispute Claim
                            </button>
                        }
                    </div>
                </div>

                <div class="details-body">
                    @if (Model.SelectedReturn.Status == "Cancelled" && !string.IsNullOrEmpty(Model.SelectedReturn.RejectionReason))
                    {
                        <div class="remarks-box mb-4" style="border-left: 4px solid var(--danger); background-color: #fef2f2;">
                            <label style="color: var(--danger); font-weight: 700;">Claim Disputed / Rejected by Supplier:</label>
                            <p style="margin-top: 0.25rem;">@Model.SelectedReturn.RejectionReason</p>
                        </div>
                    }
                    <!-- Logistics / RMA Section -->
                    <div class="info-card mb-4">
                        <h3>Shipping & RMA Details</h3>
                        <div class="info-grid">
                            <div class="info-item">
                                <label>RMA Number</label>
                                <strong>@(string.IsNullOrEmpty(Model.SelectedReturn.RMANumber) ? "PENDING AUTHORIZATION" : Model.SelectedReturn.RMANumber)</strong>
                            </div>
                            <div class="info-item">
                                <label>Carrier</label>
                                <span>@(string.IsNullOrEmpty(Model.SelectedReturn.Carrier) ? "Not Set" : Model.SelectedReturn.Carrier)</span>
                            </div>
                            <div class="info-item">
                                <label>Tracking Number</label>
                                <span>@(string.IsNullOrEmpty(Model.SelectedReturn.TrackingNumber) ? "Not Set" : Model.SelectedReturn.TrackingNumber)</span>
                            </div>
                            <div class="info-item">
                                <label>Credit Status</label>
                                <span class="badge badge-credit-@Model.SelectedReturn.CreditStatus.ToLower()">@Model.SelectedReturn.CreditStatus</span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.SelectedReturn.CreditNoteNo))
                            {
                                <div class="info-item">
                                    <label>Credit Note No</label>
                                    <strong>@Model.SelectedReturn.CreditNoteNo</strong>
                                </div>
                                <div class="info-item">
                                    <label>Credit Amount</label>
                                    <strong>Rs. @(Model.SelectedReturn.CreditAmount?.ToString("N2") ?? "0.00")</strong>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.SelectedReturn.ReplacementSKU))
                            {
                                <div class="info-item">
                                    <label>Replacement SKU</label>
                                    <strong>@Model.SelectedReturn.ReplacementSKU</strong>
                                </div>
                                <div class="info-item">
                                    <label>Replacement Qty</label>
                                    <strong>@Model.SelectedReturn.ReplacementQty?.ToString("N0")</strong>
                                </div>
                                <div class="info-item">
                                    <label>Replacement Tracking</label>
                                    <span>@(string.IsNullOrEmpty(Model.SelectedReturn.ReplacementTracking) ? "Not Set" : Model.SelectedReturn.ReplacementTracking)</span>
                                </div>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.SelectedReturn.Remarks))
                    {
                        <div class="remarks-box mb-4">
                            <label>Internal Notes / Remarks:</label>
                            <p>@Model.SelectedReturn.Remarks</p>
                        </div>
                    }

                    <!-- Items Table -->
                    <div class="table-wrap">
                        <h3>Returned Line Items</h3>
                        <table class="ims-table">
                            <thead>
                                <tr>
                                    <th>SKU</th>
                                    <th>Product Name</th>
                                    <th class="text-end">Return Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Total Price</th>
                                    <th>QC Fail Reason</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.SelectedItems)
                                {
                                    <tr>
                                        <td><strong>@item.SKU</strong></td>
                                        <td>@item.ProductName</td>
                                        <td class="text-end">@item.Quantity.ToString("N0")</td>
                                        <td class="text-end font-mono">Rs. @item.UnitPrice.ToString("N2")</td>
                                        <td class="text-end font-mono"><strong>Rs. @item.TotalPrice.ToString("N2")</strong></td>
                                        <td><span class="reason-text">@item.Reason</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-state-large">
                    <span class="material-symbols-outlined">assignment_returned</span>
                    <h2>No Return Claim Selected</h2>
                    <p>Select a return claim from the list on the left to view details and authorize it.</p>
                </div>
            }
        </section>
    </div>
</div>

<!-- Modal: Supplier Authorize Return -->
<div class="modal fade" id="supplierAuthorizeModal" tabindex="-1" aria-labelledby="supplierAuthorizeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
            <div class="modal-header bg-primary text-white" style="border-top-left-radius: 12px; border-top-right-radius: 12px;">
                <h5 class="modal-title" id="supplierAuthorizeModalLabel">Authorize Return</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="SupplierAuthorize">
                <div class="modal-body p-4">
                    <p class="text-muted">By authorizing this return, you confirm the receipt of the claim details and provide the necessary authorization codes.</p>
                    
                    <input type="hidden" id="authReturnID" asp-for="AuthorizeReturnID" />
                    
                    <div class="mb-3">
                        <label for="authReturnNo" class="form-label">Return Claim</label>
                        <input type="text" class="form-control bg-light" id="authReturnNo" readonly />
                    </div>

                    <div class="mb-3">
                        <label for="authRMA" class="form-label">RMA Number <span class="text-danger">*</span></label>
                        <input type="text" id="authRMA" asp-for="AuthorizeRMANumber" class="form-control" placeholder="e.g. RMA-99812A" required />
                        <small class="text-muted">Generate this code in your order system and provide it here.</small>
                    </div>

                    <div class="mb-3">
                        <label for="authCarrier" class="form-label">Preferred Shipping Carrier</label>
                        <input type="text" id="authCarrier" asp-for="AuthorizeCarrier" class="form-control" placeholder="e.g. FedEx, DHL" />
                    </div>

                    <div class="mb-3">
                        <label for="authTracking" class="form-label">Return Label Tracking Number</label>
                        <input type="text" id="authTracking" asp-for="AuthorizeTracking" class="form-control" placeholder="e.g. TRK-8891283" />
                    </div>

                    <div class="mb-3">
                        <label for="authCreditNote" class="form-label">Credit Note Number</label>
                        <input type="text" id="authCreditNote" asp-for="AuthorizeCreditNoteNo" class="form-control" placeholder="e.g. CRN-9912A" />
                        <small class="text-muted">Optional. Enter to issue credit note along with this authorization.</small>
                    </div>

                    <div class="mb-3">
                        <label for="authCreditAmount" class="form-label">Credit Amount (Rs.)</label>
                        <input type="number" step="0.01" id="authCreditAmount" asp-for="AuthorizeCreditAmount" class="form-control" placeholder="e.g. 500.00" />
                    </div>

                    <h4 class="mt-4 mb-3" style="font-size: 1rem; font-weight: 700; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; color: var(--primary);">Replacement / Exchange (Optional)</h4>
                    <div class="mb-3">
                        <label for="authReplacementSKU" class="form-label">Replacement SKU</label>
                        <input type="text" id="authReplacementSKU" asp-for="AuthorizeReplacementSKU" class="form-control" placeholder="e.g. SKU-12345" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="authReplacementQty" class="form-label">Replacement Quantity</label>
                            <input type="number" step="0.01" id="authReplacementQty" asp-for="AuthorizeReplacementQty" class="form-control" placeholder="e.g. 10" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="authReplacementTracking" class="form-label">Replacement Tracking No.</label>
                            <input type="text" id="authReplacementTracking" asp-for="AuthorizeReplacementTracking" class="form-control" placeholder="e.g. TRK-Replacement" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer p-3 bg-light" style="border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <span class="material-symbols-outlined">verified</span>
                        Confirm & Authorize
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Supplier Reject/Dispute Return -->
<div class="modal fade" id="supplierRejectModal" tabindex="-1" aria-labelledby="supplierRejectModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
            <div class="modal-header bg-danger text-white" style="border-top-left-radius: 12px; border-top-right-radius: 12px;">
                <h5 class="modal-title" id="supplierRejectModalLabel">Reject / Dispute Return Claim</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="SupplierReject">
                <div class="modal-body p-4">
                    <p class="text-muted">Are you sure you want to reject/dispute this return claim? Please provide a clear dispute reason.</p>
                    
                    <input type="hidden" id="rejectReturnID" asp-for="RejectReturnID" />
                    
                    <div class="mb-3">
                        <label for="rejectReturnNo" class="form-label">Return Claim</label>
                        <input type="text" class="form-control bg-light" id="rejectReturnNo" readonly />
                    </div>

                    <div class="mb-3">
                        <label for="rejectReturnReason" class="form-label">Dispute / Rejection Reason <span class="text-danger">*</span></label>
                        <textarea id="rejectReturnReason" asp-for="RejectReturnReason" class="form-control" rows="4" placeholder="e.g. Items were damaged during factory operations, return is outside the return window, or claim is incorrect" required></textarea>
                    </div>
                </div>
                <div class="modal-footer p-3 bg-light" style="border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <span class="material-symbols-outlined">cancel</span>
                        Confirm Dispute
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/supplierportal/returns.js" asp-append-version="true"></script>
}
